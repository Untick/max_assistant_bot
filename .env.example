# Telegram Bot Token (обязательно)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google OAuth (опционально, для интеграции с календарем)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# LLM API (обязательно)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=qwen-2.5-7b-instruct
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_RETRY_COUNT=3
LLM_TIMEOUT=30

# ASR (Whisper) - настройки модели
ASR_MODEL_SIZE=base
ASR_LANGUAGE=ru

# ASR Provider (whisper | yandex) - выбор провайдера транскрибации
ASR_PROVIDER=whisper

# Yandex SpeechKit (только если ASR_PROVIDER=yandex)
# Получить API ключ: https://cloud.yandex.ru/docs/iam/concepts/authorization/api-key
YANDEX_API_KEY=AQV...ваш_api_key_здесь
# ID каталога: https://cloud.yandex.ru/docs/resource-manager/operations/folder/get-id
YANDEX_FOLDER_ID=b1g...ваш_folder_id_здесь

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_planner

# Redis
REDIS_URL=redis://localhost:6379/0

# Timezone
TIMEZONE=Europe/Moscow

# RAG
RAG_CHUNK_SIZE=500
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.75

# Scheduler
SCHEDULER_TIMEZONE=Europe/Moscow

# Security (обязательно, 32 байта hex)
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_32_byte_random_key_hex_here

# Logging
LOG_LEVEL=INFO

# Service URLs
RAG_SERVICE_URL=http://rag_service:8002
MCP_SERVER_URL=http://mcp_server:8003
